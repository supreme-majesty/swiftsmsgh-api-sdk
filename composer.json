{
    "name": "swiftsmsgh/swiftsmsgh-api-sdk",
    "description": "PHP SDK for the Swiftsms-GH Bulk SMS API",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "supreme-majesty",
            "email": "reborndzre@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "platform": {
            "php": "8.0"
        }
    },
    "autoload": {
        "psr-4": {
            "Swiftsms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Swiftsms\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
      "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.92"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse",
        "cs-fix": "vendor/bin/php-cs-fixer fix"
    }
}
